# WatchLog — credentials for schema migrations and the agent.
#
# Copy to .env in the directory ABOVE the code (i.e. alongside it, not
# inside the repo) and fill in. Never commit a real .env.

# --- Supabase project --------------------------------------------------
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co

# Public by design. Safe to ship in the agent and the viewer.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Not required. The agent authenticates through SECURITY DEFINER
# functions with the publishable key; it never needs a secret key.
SUPABASE_SECRET_KEY=

# --- Postgres: migrations only, never ships to an agent ----------------
# New Supabase projects have no IPv4 record on db.<ref>.supabase.co, so
# connect through the pooler. Session mode (5432) is required for DDL.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres
