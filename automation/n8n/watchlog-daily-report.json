{
  "name": "WatchLog — daily report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "15 7 * * *" }
          ]
        }
      },
      "id": "schedule-daily-0715",
      "name": "Every day 07:15",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [260, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WATCHLOG_REPORT_RUNNER_URL }}/run/{{ $env.REPORT_RUNNER_TOKEN }}",
        "options": { "timeout": 120000 },
        "sendBody": false
      },
      "id": "call-report-runner",
      "name": "Run daily report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        }
      },
      "id": "check-ok",
      "name": "Delivered OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [780, 300]
    },
    {
      "parameters": {},
      "id": "noop-ok",
      "name": "OK",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1020, 200]
    },
    {
      "parameters": {},
      "id": "noop-fail",
      "name": "Investigate (see log_tail)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1020, 400]
    }
  ],
  "connections": {
    "Every day 07:15": { "main": [[{ "node": "Run daily report", "type": "main", "index": 0 }]] },
    "Run daily report": { "main": [[{ "node": "Delivered OK?", "type": "main", "index": 0 }]] },
    "Delivered OK?": {
      "main": [
        [{ "node": "OK", "type": "main", "index": 0 }],
        [{ "node": "Investigate (see log_tail)", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1", "timezone": "Asia/Karachi" },
  "meta": {
    "description": "WatchLog daily report. Calls the report-runner service, which composes each site's report (per-site timezone), fans out to enabled recipients, and is idempotent (a day's report is sent once per destination). Retries are safe. No secrets are stored in this file: WATCHLOG_REPORT_RUNNER_URL and REPORT_RUNNER_TOKEN are n8n environment variables. The runner is dry-run until REPORT_SEND=true is set on the service (a real external send needs the customer's go-ahead)."
  }
}
