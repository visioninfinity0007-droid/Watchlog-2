; WatchLog site agent — configuration
;
; Copy to watchlog.ini and fill in. Place it beside watchlog_agent.py,
; or beside watchlog-agent.exe once frozen.
;
; SECRETS GATE: you enter the recorder password here for FIRST-RUN ONLY.
; Setup migrates it into the machine's encrypted DPAPI store and it should NOT
; remain in this file afterward (the --accept security check fails if it does).
; The one-time enrollment code is consumed on first run. This file is gitignored;
; never commit it, never paste its contents into chat or a log.
;
; Every setting can also be supplied as an environment variable named
; WATCHLOG_<KEY_IN_UPPERCASE>, which takes precedence over this file.

[watchlog]

; --- cloud -----------------------------------------------------------
supabase_url = https://YOUR-PROJECT.supabase.co

; The PUBLISHABLE key (sb_publishable_...). Public by design — it grants
; nothing on its own. Every table is behind RLS with no policies; the
; agent reaches the database only through SECURITY DEFINER functions and
; proves identity with the per-agent secret minted at enrollment.
; Never put a secret key (sb_secret_...) in this file.
supabase_publishable_key = sb_publishable_REPLACE_ME

; One-time enrollment code. Consumed on first run; ignored afterwards.
; Each machine needs its own code.
enrollment_code = WL-PROTO-DEV-0001

; --- the recorder on the local LAN -----------------------------------
; The installer types their own NVR details here for first-run. These credentials
; never leave the site (only event metadata is sent upward), and the password is
; moved into the encrypted DPAPI store by setup — leave nvr_password = REPLACE_ME
; here once setup has run; it is not read from this file after migration.
nvr_url      = http://192.168.1.108
nvr_username = admin
nvr_password = REPLACE_ME

; auto | hikvision-isapi | dahua-cgi | onvif | mock
;   hikvision-isapi  Hikvision, HiLook
;   dahua-cgi        Dahua, Imou, CP Plus and other Dahua-OEM recorders
;   onvif            Uniview, Tiandy, and most other ONVIF-conformant units
;   mock             the bundled test device, for dry runs
; 'auto' probes them in that order and keeps the first that answers.
; Run `watchlog-agent.exe --probe` to see what it detects before enrolling.
nvr_driver = auto

; --- false-alarm filtering -------------------------------------------
; Every event that carries a still is shown to YOLOv8n on THIS machine
; before it is sent. If the frame holds no person, car or motorcycle it
; is treated as a false alarm and discarded at the site — rain, headlights
; on a wall, a cat, an IR lamp cutting in at dusk. Without this a single
; recorder produces hundreds of events a night and the morning report is
; unreadable.
;
; No frame ever leaves the building for detection. Only stills attached to
; events that already passed the filter are uploaded.
;
; If ultralytics is not installed, or the weights cannot load, the filter
; disables itself and EVERY event is reported. It never fails closed —
; a missed incident is invisible, an extra one is only noise.
;
; detect            = true
; detect_model      = yolov8n.pt      ; downloaded on first run if absent
; detect_confidence = 0.35            ; below this, an object is a guess
; detect_classes    = person,car,motorcycle   ; the scope covers these three

; --- automatic NVR outage recovery (0.4.4) ---------------------------
; After a monitoring gap, WatchLog reconnects, detects the exact missed
; interval, and — READ ONLY — backfills recoverable intelligence from the
; recorder's own archive. It never writes to the recorder, always yields to
; live monitoring, and is bandwidth/CPU throttled. On by default; recovered
; coverage is reported separately from live coverage, never blended.
; recovery_enabled           = true
; recovery_seconds           = 300     ; how often to look for intervals to recover
; recovery_chunk_seconds     = 3600    ; bounded work per pass (resumable via checkpoints)
; recovery_throttle_seconds  = 2.0     ; pause between chunks (be gentle on the recorder)
; recovery_threshold_seconds = 180     ; a gap longer than this counts as an outage

; --- in-app updates (0.4.4) ------------------------------------------
; `watchlog-agent --check-update` fetches a SIGNED release manifest over HTTPS
; for this site's channel and reports whether a newer version is available. It
; is READ ONLY and never installs anything. With no update_public_key set an
; update is refused, because the manifest cannot be trusted.
; update_url               = https://YOUR-HOST/watchlog/manifest.json
; update_channel           = production   ; internal | pilot | beta | production
; update_public_key        =              ; base64 Ed25519 release-signing public key
; update_require_signature = true

; --- diagnostics (change nothing; safe to run any time) --------------
;   watchlog-agent --probe           identify the recorder on the LAN
;   watchlog-agent --accept          post-install acceptance self-test
;   watchlog-agent --check-update    check for a newer signed release (read-only)
;   watchlog-agent --support-bundle  export a non-secret diagnostics .zip for support

; --- optional --------------------------------------------------------
; state_dir         = C:\ProgramData\WatchLog
; state_file        = C:\ProgramData\WatchLog\agent_state.json
; spool_file        = C:\ProgramData\WatchLog\spool.sqlite
; heartbeat_seconds = 60
; upload_seconds    = 15
