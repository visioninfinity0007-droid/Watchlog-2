# WatchLog — credentials for schema migrations and the agent.
#
# Copy to .env in the directory ABOVE the code (i.e. alongside it, not
# inside the repo) and fill in. Never commit a real .env.

# --- Supabase project --------------------------------------------------
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co

# Public by design. Safe to ship in the agent and the viewer.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Not required. The agent authenticates through SECURITY DEFINER
# functions with the publishable key; it never needs a secret key.
SUPABASE_SECRET_KEY=

# --- Postgres: migrations only, never ships to an agent ----------------
# New Supabase projects have no IPv4 record on db.<ref>.supabase.co, so
# connect through the pooler. Session mode (5432) is required for DDL.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# --- Reporting: daily WhatsApp + email ---------------------------------
# WatchLog owns its own reporting config. These take precedence; the
# reporter only falls back to a sibling project's env if these are unset,
# and that fallback goes away once WatchLog's own .env carries them.

# Used in email bodies and CTAs. Point at the portal (prod domain when set).
WATCHLOG_PORTAL_URL=

# WhatsApp via Evolution API (M1).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
WATCHLOG_WHATSAPP_INSTANCE=

# Email via SendGrid — branded HTML daily report (M3).
SENDGRID_API_KEY=
SENDGRID_FROM=

# --- Report-runner service (n8n calls POST /run/<token>) ---------------
REPORT_RUNNER_TOKEN=            # shared secret in the /run/<token> path
# REPORT_SEND=true             # set on the deployed service to actually send

# --- Billing service (M3) ---------------------------------------------
BILLING_WEBHOOK_SECRET=         # HMAC secret for the mock webhook signature
BILLING_ALLOW_MOCK=false        # true only on demo/staging (enables the sandbox provider)
# Portal build-time (portal/.env.local): where checkout lives + which provider
# NEXT_PUBLIC_BILLING_URL=https://watchlog-billing.example
# NEXT_PUBLIC_BILLING_PROVIDER=mock   # 'switch' for production once the adapter is configured
# NEXT_PUBLIC_INSTALLER_URL=          # real installer download, once hosted
